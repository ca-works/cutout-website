---
import { Image } from 'astro:assets';
import icon from '../assets/generated/brand/icon.png';

const base = import.meta.env.BASE_URL;
const home = Astro.url.pathname === base;
const at = (hash: string) => (home ? hash : `${base}${hash}`);
const links = [
  { href: `${base}science/`, label: 'How it works' },
  { href: at('#compare'), label: 'Results' },
  { href: at('#app'), label: 'The app' },
  { href: at('#privacy'), label: 'Privacy' },
  { href: `${base}docs/`, label: 'Guide' },
];
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
---

<header class:list={['nav', { 'nav--solid': !home }]} data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href={base} aria-label="CutOut home">
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2]} loading="eager" />
      <span>CutOut</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul role="list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="nav__cta" href={at('#get')}>Get CutOut</a>
    <button class="nav__menu-btn" type="button" popovertarget="nav-menu" aria-label="Menu">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 9h16M4 15h16"></path></svg>
    </button>
  </div>
  <div class="nav__sheet" id="nav-menu" popover>
    <nav aria-label="Main (menu)">
      <ul role="list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
        <li><a href={at('#get')}>Get CutOut</a></li>
      </ul>
    </nav>
    <button class="nav__close" type="button" popovertarget="nav-menu" popovertargetaction="hide">Close menu</button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    transition: background-color 400ms linear, box-shadow 400ms linear, backdrop-filter 400ms linear;
  }

  :global(.nav.is-scrolled),
  .nav--solid {
    background: rgb(5 5 7 / 0.72);
    -webkit-backdrop-filter: saturate(1.6) blur(20px);
    backdrop-filter: saturate(1.6) blur(20px);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    padding: 6px 2px;
    font-weight: 720;
    font-stretch: 110%;
    font-size: 1.125rem;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .nav__brand img {
    width: 30px;
    height: 30px;
  }

  .nav__links ul {
    display: flex;
    gap: 4px;
  }

  .nav__links a,
  .nav__sheet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 520;
    color: var(--fg-2);
    text-decoration: none;
    transition: color 200ms linear;
  }

  .nav__links a[aria-current='page'] {
    color: var(--fg);
  }

  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--fg);
    }
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.9375rem;
    font-weight: 620;
    text-decoration: none;
    transition: box-shadow 300ms var(--ease);
  }

  @media (hover: hover) {
    .nav__cta:hover {
      box-shadow: 0 0 0 4px var(--cut-glow);
    }
  }

  .nav__menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .nav__menu-btn svg {
    width: 22px;
    height: 22px;
  }

  .nav__sheet {
    margin: 0;
    inset: 8px 8px auto auto;
    width: min(320px, calc(100vw - 16px));
    padding: 16px;
    border: 0;
    border-radius: 22px;
    background: var(--bg-3);
    color: var(--fg);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.9), 0 0 0 1px var(--line-2);
  }

  .nav__sheet::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .nav__sheet ul {
    display: grid;
    gap: 2px;
    margin-bottom: 12px;
  }

  .nav__sheet a {
    display: flex;
    width: 100%;
    font-size: 1.0625rem;
    color: var(--fg);
    border-radius: 14px;
    padding: 0 16px;
  }

  .nav__close {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.08);
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 819px) {
    .nav__links {
      display: none;
    }

    .nav__menu-btn {
      display: inline-grid;
    }

    .nav__inner {
      gap: 12px;
    }
  }
</style>

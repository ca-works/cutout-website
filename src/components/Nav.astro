---
import { Image } from 'astro:assets';
import icon from '../assets/generated/brand/icon.png';
import { isReleased } from '../data/release';

const base = import.meta.env.BASE_URL;
const home = Astro.url.pathname === base;
const at = (hash: string) => (home ? hash : `${base}${hash}`);
const links = [
  { href: at('#compare'), label: 'Compare' },
  { href: at('#interface'), label: 'The app' },
  { href: at('#features'), label: 'Features' },
  { href: at('#privacy'), label: 'Privacy' },
  { href: `${base}docs/`, label: 'Guide' },
];
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a class="nav__brand" href={base} aria-label="CutOut home">
      <Image src={icon} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
      <span>CutOut</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul role="list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav__end">
      <a class="nav__cta" href={at('#download')}>{isReleased ? 'Download' : 'Get CutOut'}</a>
      <button class="nav__menu-btn" type="button" popovertarget="nav-menu" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="nav__sheet" id="nav-menu" popover>
    <nav aria-label="Main (menu)">
      <ul role="list">
        {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
        <li><a href={at('#download')}>Download</a></li>
        <li><a href={at('#faq')}>Questions</a></li>
      </ul>
    </nav>
    <button class="nav__close" type="button" popovertarget="nav-menu" popovertargetaction="hide">Close menu</button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: rgb(243 243 240 / 0.94);
    -webkit-backdrop-filter: saturate(1.4) blur(18px);
    backdrop-filter: saturate(1.4) blur(18px);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow var(--t-med) linear;
  }

  :global(.nav.is-scrolled) {
    box-shadow: 0 1px 0 var(--rule);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 680;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    margin-right: auto;
    padding: 6px 4px;
    margin-left: -4px;
  }

  .nav__brand img {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 1px 1.5px rgb(13 16 32 / 0.25));
  }

  .nav__links ul {
    display: flex;
    gap: var(--s-1);
  }

  .nav__links a,
  .nav__sheet a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 520;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--t-fast) linear, background-color var(--t-fast) linear;
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
  }

  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--ink);
      background: rgb(13 16 32 / 0.05);
    }
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--s-4);
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow var(--t-med) var(--ease-out);
  }

  @media (hover: hover) {
    .nav__cta:hover {
      box-shadow: 0 0 0 4px var(--cut-glow);
    }
  }

  .nav__menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .nav__menu-btn svg {
    width: 22px;
    height: 22px;
  }

  .nav__sheet {
    margin: 0;
    inset: var(--s-2) var(--s-2) auto auto;
    width: min(320px, calc(100vw - 16px));
    padding: var(--s-4);
    border: 0;
    border-radius: 20px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: var(--shadow-3), 0 0 0 1px var(--rule);
  }

  .nav__sheet::backdrop {
    background: rgb(13 16 32 / 0.18);
  }

  .nav__sheet ul {
    display: grid;
    gap: 2px;
    margin-bottom: var(--s-3);
  }

  .nav__sheet a {
    display: flex;
    width: 100%;
    font-size: 1.0625rem;
    color: var(--ink);
    border-radius: 12px;
    padding: 0 var(--s-4);
  }

  .nav__sheet a:active {
    background: rgb(13 16 32 / 0.06);
  }

  .nav__close {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: 12px;
    background: var(--paper-sunk);
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 819px) {
    .nav__links {
      display: none;
    }

    .nav__menu-btn {
      display: inline-grid;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>

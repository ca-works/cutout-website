---
import { Image } from 'astro:assets';
import icon from '../assets/generated/brand/icon.png';
import { release, mac, universal, windows, isReleased, releasesUrl, formatBytes, formatDate } from '../data/release';
import { requirements } from '../data/facts';

const base = import.meta.env.BASE_URL;
const others = [
  {
    name: 'Intel Mac',
    edition: universal,
    missing: 'Not available. CutOut 0.1 is built for Apple silicon only.',
  },
  {
    name: 'Windows',
    edition: windows,
    missing: 'Not available yet. The engine is portable Rust; a native Windows app is planned but not built.',
  },
  {
    name: 'Linux',
    edition: null,
    missing: 'Not available.',
  },
];
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Download</p>
      <h2 class="h2" id="download-title">{isReleased ? `Get CutOut ${mac.version}.` : 'Almost ready to download.'}</h2>
      <p class="lede">
        {
          isReleased
            ? 'Downloads come straight from GitHub Releases, with a SHA-256 checksum you can verify.'
            : 'The first public build of CutOut 0.1 is being prepared. Downloads will appear here the moment it is published on GitHub Releases.'
        }
      </p>
    </header>

    <div class="dl">
      <article class="dl__main" aria-labelledby="dl-mac-title" data-reveal>
        <div class="dl__head">
          <Image src={icon} alt="" width={88} height={88} densities={[1, 2]} loading="lazy" />
          <div>
            <h3 id="dl-mac-title" class="h3">CutOut for Mac</h3>
            <p class="muted small">Apple silicon · {requirements.os}</p>
          </div>
          {
            isReleased ? (
              mac.preview && <span class="pill pill--preview">Preview</span>
            ) : (
              <span class="pill">Coming soon</span>
            )
          }
        </div>

        {
          isReleased ? (
            <div class="dl__action">
              <a class="btn dl__btn" href={mac.url} download>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
                </svg>
                Download CutOut {mac.version}
              </a>
              <p class="dl__meta small tabular">
                <span>{mac.file}</span>
                <span>{formatBytes(mac.size)}</span>
                <span>Released {formatDate(mac.published)}</span>
              </p>
              <div class="sha">
                <span class="sha__label small">SHA-256</span>
                <code class="sha__value" id="sha-mac">
                  {mac.sha256}
                </code>
                <button class="sha__copy" type="button" data-copy="sha-mac" hidden>
                  Copy
                </button>
              </div>
              <p class="small">
                <a href={mac.releaseUrl} rel="noopener">
                  Release notes
                </a>
                {releasesUrl && (
                  <>
                    {' · '}
                    <a href={releasesUrl} rel="noopener">
                      All releases
                    </a>
                  </>
                )}
              </p>
            </div>
          ) : (
            <div class="dl__pending">
              <p>
                The first public build is being prepared. When it is published, this card will show the download with its exact size and SHA-256
                checksum — read from the release itself. Until then, this page links to no file at all.
              </p>
            </div>
          )
        }

        <dl class="reqs">
          <div>
            <dt>System</dt>
            <dd>{requirements.os}</dd>
          </div>
          <div>
            <dt>Mac</dt>
            <dd>{requirements.chip}</dd>
          </div>
          <div>
            <dt>Download</dt>
            <dd>DMG, {requirements.fullBuild}</dd>
          </div>
          <div>
            <dt>Signing</dt>
            <dd>{requirements.signing} — see below</dd>
          </div>
        </dl>
      </article>

      <aside class="dl__others" aria-labelledby="dl-others-title" data-reveal="2">
        <h3 id="dl-others-title" class="dl__label">Other platforms</h3>
        <ul role="list">
          {
            others.map((o) => (
              <li>
                <span class="dl__os">{o.name}</span>
                {o.edition?.available ? (
                  <a href={o.edition.url} download>
                    Download {o.edition.version} ({formatBytes(o.edition.size)})
                  </a>
                ) : (
                  <span class="muted small">{o.missing}</span>
                )}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <div class="install" id="install">
      <div class="install__col" data-reveal>
        <h3 class="h3">Opening CutOut the first time</h3>
        <p class="muted">
          CutOut 0.1 is signed ad hoc and not notarized by Apple, so macOS asks you to confirm before the first launch. This is expected — and a
          good moment to check the checksum.
        </p>
        <ol class="steps-list" role="list">
          <li><span class="tabular">1</span>Open the DMG and drag CutOut to Applications.</li>
          <li>
            <span class="tabular">2</span>Open CutOut. macOS says it can’t check the app for malicious software — choose <strong>Done</strong>.
          </li>
          <li>
            <span class="tabular">3</span>Open <strong>System Settings ▸ Privacy &amp; Security</strong>, scroll to Security and click <strong>Open Anyway</strong>,
            then confirm with your password.
          </li>
        </ol>
        <p class="small muted">On macOS 14 Sonoma you can instead Control-click CutOut in Applications and choose Open. Full details are in the <a href={`${base}docs/#install`}>guide</a>.</p>
      </div>
      <div class="install__col" data-reveal="2">
        <h3 class="h3">Check the download</h3>
        <p class="muted">Compare the file’s checksum with the one published on its release. In Terminal:</p>
        <pre class="code"><code id="cmd-shasum">shasum -a 256 ~/Downloads/{mac.file}</code></pre>
        <button class="sha__copy" type="button" data-copy="cmd-shasum" hidden>Copy command</button>
        <p class="small muted">
          The result must match the SHA-256 {isReleased ? 'shown above' : 'shown here once the build is published'} and in the release’s
          <code>SHA256SUMS.txt</code>. If it doesn’t, delete the file and <a href={`${base}docs/#security`}>tell us</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .dl {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--s-5);
    margin-bottom: clamp(var(--s-8), 6vw, var(--s-9));
  }

  .dl__main {
    display: grid;
    gap: var(--s-6);
    padding: clamp(var(--s-5), 4vw, var(--s-8));
    border-radius: var(--r-stage);
    background: var(--paper-raised);
    box-shadow: var(--shadow-2), inset 0 0 0 1px var(--rule);
  }

  .dl__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
  }

  .dl__head img {
    width: 88px;
    height: 88px;
    filter: drop-shadow(0 6px 10px rgb(13 16 32 / 0.2));
  }

  .pill {
    align-self: start;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--paper-sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .pill--preview {
    background: rgb(88 71 240 / 0.1);
    color: var(--cut-deep);
  }

  .dl__pending {
    padding: var(--s-5);
    border-radius: var(--r-control);
    background: var(--paper);
    border: 1.5px dashed var(--rule-strong);
    color: var(--ink-2);
  }

  .dl__action {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .dl__btn {
    min-height: 56px;
    font-size: 1.125rem;
  }

  .dl__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    color: var(--ink-2);
  }

  .sha {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-control);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .sha__label {
    font-weight: 600;
    color: var(--ink-2);
  }

  .sha__value {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  .sha__copy {
    min-height: 36px;
    padding: 0 var(--s-3);
    border: 0;
    border-radius: 999px;
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .reqs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-6);
    margin: 0;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .reqs dt {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .reqs dd {
    margin: 0;
    font-size: var(--step--1);
  }

  .dl__others {
    padding: clamp(var(--s-5), 3vw, var(--s-7));
    border-radius: var(--r-stage);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .dl__label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: var(--s-3);
  }

  .dl__others li {
    display: grid;
    gap: 2px;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .dl__others li:last-child {
    border-bottom: 0;
  }

  .dl__os {
    font-weight: 620;
  }

  .install {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--s-6), 5vw, var(--s-9));
  }

  .install__col {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .steps-list {
    display: grid;
    gap: var(--s-3);
  }

  .steps-list li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--s-3);
  }

  .steps-list li > span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .code {
    margin: 0;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-control);
    background: var(--night);
    color: var(--on-night);
    font-size: 0.875rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .install__col .sha__copy {
    justify-self: start;
  }

  @media (max-width: 1079px) {
    .dl {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 819px) {
    .install {
      grid-template-columns: minmax(0, 1fr);
    }

    .reqs {
      grid-template-columns: minmax(0, 1fr);
    }

    .dl__head {
      grid-template-columns: auto 1fr;
    }

    .dl__head .pill {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .dl__head img {
      width: 64px;
      height: 64px;
    }
  }
</style>

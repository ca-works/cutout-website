---
import { Picture } from 'astro:assets';
import d1 from '../assets/screens/dark-1-empty.png';
import d2 from '../assets/screens/dark-2-removed.png';
import d3 from '../assets/screens/dark-3-advanced-tools.png';
import l1 from '../assets/screens/light-1-empty.png';
import l2 from '../assets/screens/light-2-removed.png';
import l3 from '../assets/screens/light-3-advanced-tools.png';

const steps = [
  {
    id: 'paste',
    n: '01',
    title: 'Paste or drop',
    text: 'CutOut opens to one quiet window. Press ⌘V with an image on the clipboard, drop a file on it, or open one. Nothing is uploaded.',
    dark: d1,
    light: l1,
    alt: 'CutOut’s empty window: “Remove any background — paste with ⌘V or drop an image here”, with Paste Image and Open buttons.',
  },
  {
    id: 'remove',
    n: '02',
    title: 'Remove',
    text: 'Remove Background (⌘B) runs on your Mac. A toast reports the time; the status bar names the engine that ran — here Core ML on the GPU.',
    dark: d2,
    light: l2,
    alt: 'CutOut with the cat cut out on a transparency grid, a “Background removed in 2.5 s” message and “Core ML · GPU” in the status bar.',
  },
  {
    id: 'refine',
    n: '03',
    title: 'Refine',
    text: 'When you need more, the tools sidebar (⌥⌘T) and layers inspector (⌥⌘L) slide in: Magic Eraser, selections, brushes, text, shapes, crop and refine edges.',
    dark: d3,
    light: l3,
    alt: 'CutOut with the tools sidebar showing the Magic Eraser options (tolerance, contiguous, anti-alias edges, edge feather) and the layers inspector.',
  },
];
const widths = [720, 1080, 1440, 1800, 2360];
const sizes = '(max-width: 1079px) calc(100vw - 40px), 760px';
---

<section class="section showcase on-night" id="interface" aria-labelledby="interface-title" data-showcase data-appearance="dark">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">The app</p>
      <h2 class="h2" id="interface-title">Simple until you need&nbsp;more.</h2>
      <p class="lede">A native Mac app — SwiftUI and AppKit over a Rust engine — that stays out of the way until you reach for its tools.</p>
    </header>

    <div class="showcase__body">
      <div class="showcase__steps" role="tablist" aria-label="Workflow step" aria-orientation="vertical" data-steps>
        {
          steps.map((s, i) => (
            <button
              class="step"
              type="button"
              role="tab"
              id={`step-tab-${s.id}`}
              aria-controls="showcase-window"
              aria-selected={i === 1 ? 'true' : 'false'}
              tabindex={i === 1 ? 0 : -1}
            >
              <span class="step__n tabular">{s.n}</span>
              <span class="step__title">{s.title}</span>
              <span class="step__text">{s.text}</span>
            </button>
          ))
        }
      </div>

      <figure class="showcase__figure" data-reveal>
        <div class="window" id="showcase-window" role="tabpanel" data-window data-current="1">
          {
            steps.map((s, i) => (
              <div class={`window__shot window__shot--${i}`} data-shot={i}>
                <Picture class="shot shot--dark" src={s.dark} widths={widths} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" alt={s.alt} loading="lazy" decoding="async" />
                <Picture class="shot shot--light" src={s.light} widths={widths} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" alt={s.alt} loading="lazy" decoding="async" />
              </div>
            ))
          }
        </div>
        <figcaption class="showcase__caption">
          <div class="seg seg--night" role="radiogroup" aria-label="Screenshot appearance" data-appearance-switch hidden>
            <button class="seg__btn" type="button" role="radio" aria-checked="true" tabindex="0" data-value="dark">Dark</button>
            <button class="seg__btn" type="button" role="radio" aria-checked="false" tabindex="-1" data-value="light">Light</button>
          </div>
          <p class="small">Genuine CutOut 0.1 windows, rendered by the app's own self-test. CutOut follows the system appearance.</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    overflow: clip;
  }

  .showcase::before {
    /* A single soft key light from the top-left, as in the icon. */
    content: '';
    position: absolute;
    inset: -20% 30% 40% -20%;
    background: radial-gradient(closest-side, rgb(88 71 240 / 0.16), transparent);
    pointer-events: none;
  }

  .showcase__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(var(--s-6), 4vw, var(--s-9));
    align-items: center;
  }

  .showcase__steps {
    display: grid;
    gap: var(--s-2);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s-4);
    row-gap: var(--s-1);
    padding: var(--s-5);
    border: 0;
    border-radius: var(--r-media);
    background: transparent;
    color: var(--on-night-2);
    text-align: left;
    cursor: pointer;
    transition: background-color var(--t-med) linear, color var(--t-med) linear;
  }

  .step__n {
    grid-row: span 2;
    font-size: var(--step--1);
    font-weight: 600;
    padding-top: 0.2em;
    color: var(--on-night-3);
  }

  .step__title {
    font-size: var(--step-1);
    font-weight: 620;
    letter-spacing: -0.02em;
    color: var(--on-night);
  }

  .step__text {
    font-size: var(--step--1);
    line-height: 1.55;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height var(--t-med) var(--ease-out), opacity var(--t-med) linear;
  }

  .step[aria-selected='true'] {
    background: var(--night-2);
    box-shadow: inset 0 0 0 1px var(--rule-night);
  }

  .step[aria-selected='true'] .step__n {
    color: var(--cut-bright);
  }

  .step[aria-selected='true'] .step__text,
  :global(.showcase:not(.is-enhanced)) .step__text {
    max-height: 12em;
    opacity: 1;
  }

  @media (hover: hover) {
    .step:not([aria-selected='true']):hover {
      background: rgb(255 255 255 / 0.03);
    }
  }

  .showcase__figure {
    display: grid;
    gap: var(--s-5);
    perspective: 1600px;
  }

  .window {
    position: relative;
    aspect-ratio: 2360 / 1560;
    border-radius: 2.2% / 3.3%;
    box-shadow: var(--shadow-window);
    transform-origin: 50% 100%;
    transition: transform 1100ms var(--ease-out);
  }

  /* The window settles from a slight backward tilt when it scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.showcase__figure.reveal-pending) .window {
      transform: rotateX(16deg) scale(0.94);
    }
  }

  .window__shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--t-med) linear;
  }

  .window[data-current='0'] .window__shot--0,
  .window[data-current='1'] .window__shot--1,
  .window[data-current='2'] .window__shot--2 {
    opacity: 1;
  }

  .window__shot :global(picture),
  .window__shot :global(img) {
    width: 100%;
    height: 100%;
  }

  .showcase[data-appearance='dark'] .window__shot :global(.shot--light),
  .showcase[data-appearance='light'] .window__shot :global(.shot--dark) {
    display: none;
  }

  .showcase__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    color: var(--on-night-3);
  }

  .showcase__caption p {
    max-width: 52ch;
  }

  .seg--night {
    background: var(--night-2);
    box-shadow: inset 0 0 0 1px var(--rule-night);
  }

  .seg--night .seg__btn {
    color: var(--on-night-2);
    min-height: 36px;
    font-size: 0.875rem;
  }

  .seg--night .seg__btn[aria-checked='true'] {
    background: var(--night-3);
    color: var(--on-night);
    box-shadow: none;
  }

  @media (max-width: 1079px) {
    .showcase__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase__figure {
      order: -1;
    }

    .showcase__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      padding: var(--s-3) var(--s-4);
    }

    .step__title {
      font-size: 1rem;
      line-height: 1.25;
    }

    .step__text {
      display: none;
    }

    .step__n {
      grid-row: auto;
    }
  }

  :global(.step-live) {
    display: none;
  }

  @media (max-width: 1079px) {
    :global(.step-live) {
      display: block;
      margin-top: var(--s-4);
      color: var(--on-night-2);
      max-width: 60ch;
    }
  }
</style>

<script>
  import { wireTabs, wireRadios } from '../scripts/a11y';
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    root.classList.add('is-enhanced');
    const win = root.querySelector<HTMLElement>('[data-window]')!;
    const steps = root.querySelector<HTMLElement>('[data-steps]')!;
    const live = document.createElement('p');
    live.className = 'step-live small';
    steps.after(live);
    const describe = (i: number) => {
      const tab = steps.querySelectorAll<HTMLElement>('[role="tab"]')[i];
      live.textContent = tab.querySelector('.step__text')!.textContent;
      win.setAttribute('aria-labelledby', tab.id);
    };
    wireTabs(steps, (i) => {
      win.dataset.current = String(i);
      describe(i);
    });
    describe(1);
    const sw = root.querySelector<HTMLElement>('[data-appearance-switch]')!;
    sw.hidden = false;
    wireRadios(sw, (v) => (root.dataset.appearance = v));
  }
</script>

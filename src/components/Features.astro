---
import { Image } from 'astro:assets';
import cat from '../assets/generated/samples/cat.jpg';
import catMatte from '../assets/generated/samples/cat-matte.png';
import catCut from '../assets/generated/samples/cat-cutout.png';
import { capabilities } from '../data/facts';

const layers = [
  { src: catCut, label: 'Result', note: 'What you copy', cls: 'result' },
  { src: catMatte, label: 'Mask', note: 'What removal changes', cls: 'mask' },
  { src: cat, label: 'Pixels', note: 'Never touched', cls: 'pixels' },
];
// CIEDE2000 distances computed for exactly these sRGB values (see docs/DESIGN.md).
const swatches = [
  { hex: '#d9cbb0', name: 'Beige backdrop', de: null },
  { hex: '#d1c3a8', name: 'Beige in shadow', de: '2.0' },
  { hex: '#f0eee9', name: 'White part', de: '11.8' },
];
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Features</p>
      <h2 class="h2" id="features-title">A complete toolkit, folded&nbsp;away.</h2>
      <p class="lede">Most cutouts need one key. For the ones that don’t, CutOut has the tools of a proper image editor — and none of them are in your way until you open them.</p>
    </header>

    <div class="moments">
      <article class="moment" data-reveal>
        <div class="stack" aria-hidden="true">
          {
            layers.map((l) => (
              <div class={`stack__plane stack__plane--${l.cls}`}>
                <Image src={l.src} alt="" widths={[360, 560, 720]} sizes="(max-width: 819px) 60vw, 300px" loading="lazy" decoding="async" />
                <span class="stack__label">
                  <strong>{l.label}</strong> {l.note}
                </span>
              </div>
            ))
          }
        </div>
        <ol class="stack__legend" role="list" aria-label="Layer structure, top to bottom">
          {layers.map((l) => (
            <li>
              <strong>{l.label}</strong> {l.note}
            </li>
          ))}
        </ol>
        <div class="moment__text">
          <h3 class="h3">Nothing is ever really erased.</h3>
          <p class="muted">
            Background removal, the Eraser and the Magic Eraser all write to a layer mask. The pixels underneath stay exactly as they were, so the
            Restore brush — or Restore All — brings back anything, at any time. The mask shown here is the one CutOut made for this photo.
          </p>
        </div>
      </article>

      <article class="moment moment--flip" data-reveal>
        <figure class="de" aria-labelledby="de-caption">
          <div class="de__row" role="list">
            {
              swatches.map((s) => (
                <div class="de__item" role="listitem">
                  <span class={`de__chip de__chip--${s.hex.slice(1)}`} />
                  <span class="de__name">{s.name}</span>
                  <span class="de__value tabular">{s.de ? `ΔE ${s.de}` : 'Where you click'}</span>
                </div>
              ))
            }
          </div>
          <figcaption id="de-caption" class="small">
            With the Magic Eraser’s tolerance at 8 ΔE, a click on the beige takes its shadow (ΔE 2.0) and leaves the white part (ΔE 11.8). Swatch
            distances are CIEDE2000, computed for these exact colours.
          </figcaption>
        </figure>
        <div class="moment__text">
          <h3 class="h3">Colour, measured the way you see it.</h3>
          <p class="muted">
            The Magic Eraser and Magic Wand compare colours with CIEDE2000 — the perceptual colour-difference formula — instead of raw RGB. So a
            beige backdrop goes, shadows and all, while a white part that sits on it stays. Anti-aliased edge pixels get partial coverage instead of
            a jagged line.
          </p>
        </div>
      </article>
    </div>

    <div class="index" role="list" aria-label="Everything in CutOut 0.1">
      {
        capabilities.map((c, i) => (
          <div class="index__row" role="listitem" data-reveal>
            <span class="index__n tabular" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="index__name">{c.name}</h3>
            <p class="index__line">{c.line}</p>
            <ul class="index__items" role="list">
              {c.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .moments {
    display: grid;
    gap: clamp(var(--s-8), 8vw, var(--s-10));
    margin-bottom: clamp(var(--s-9), 9vw, var(--s-11));
  }

  .moment {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(var(--s-6), 6vw, var(--s-10));
    align-items: center;
  }

  .moment--flip > :first-child {
    order: 2;
  }

  .moment__text {
    display: grid;
    gap: var(--s-4);
  }

  .moment__text .muted {
    max-width: 44ch;
  }

  /* ---- mask stack: three planes in an isometric stack ---- */
  .stack {
    position: relative;
    height: clamp(340px, 38vw, 520px);
    perspective: 1800px;
  }

  .stack__plane {
    --z: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(200px, 22vw, 300px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotateX(58deg) rotateZ(-38deg) translateZ(var(--z));
    transform-style: preserve-3d;
    transition: transform 900ms var(--ease-out);
  }

  .stack__plane img {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgb(13 16 32 / 0.1), 0 30px 40px -20px rgb(13 16 32 / 0.45);
  }

  .stack__plane--result img {
    background: conic-gradient(#e4e5ea 25%, #fff 0 50%, #e4e5ea 0 75%, #fff 0) 0 0 / 18px 18px;
  }

  .stack__plane--mask img {
    opacity: 0.94;
  }

  .stack__plane--result {
    --z: 140px;
  }

  .stack__plane--pixels {
    --z: -140px;
  }

  .stack__legend {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.moment.reveal-pending) .stack__plane {
      --z: 0px;
    }
  }

  .stack__label {
    position: absolute;
    left: 100%;
    top: 50%;
    margin-left: 56px;
    width: max-content;
    transform: rotateZ(38deg) rotateX(-58deg);
    transform-origin: left center;
    font-size: 0.8125rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .stack__label strong {
    display: block;
    color: var(--ink);
    font-size: 0.9375rem;
  }

  /* ---- ΔE illustration ---- */
  .de {
    display: grid;
    gap: var(--s-5);
    padding: clamp(var(--s-5), 3vw, var(--s-7));
    border-radius: var(--r-stage);
    background: var(--paper-raised);
    box-shadow: var(--shadow-2);
  }

  .de__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .de__item {
    display: grid;
    gap: var(--s-2);
  }

  .de__chip {
    aspect-ratio: 1;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgb(13 16 32 / 0.08);
  }

  .de__chip--d9cbb0 {
    background: #d9cbb0;
    box-shadow: 0 0 0 2px var(--paper-raised), 0 0 0 4px var(--cut);
  }

  .de__chip--d1c3a8 {
    background: #d1c3a8;
  }

  .de__chip--f0eee9 {
    background: #f0eee9;
  }

  .de__name {
    font-size: var(--step--1);
    font-weight: 560;
  }

  .de__value {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .de figcaption {
    color: var(--ink-2);
    max-width: 56ch;
  }

  /* ---- capability index ---- */
  .index {
    border-top: 1px solid var(--rule-strong);
  }

  .index__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 3fr) minmax(0, 4fr) minmax(0, 5fr);
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .index__row::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 0;
    border-bottom: 1.5px dashed var(--cut);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease-out);
  }

  @media (hover: hover) {
    .index__row:hover::before {
      transform: scaleX(1);
    }
  }

  .index__n {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-3);
    padding-top: 0.3em;
  }

  .index__name {
    font-size: var(--step-2);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .index__line {
    color: var(--ink-2);
    padding-top: 0.2em;
  }

  .index__items {
    display: grid;
    gap: 6px;
    font-size: var(--step--1);
    padding-top: 0.25em;
  }

  .index__items li {
    position: relative;
    padding-left: 18px;
  }

  .index__items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    border-top: 1.5px solid var(--rule-strong);
  }

  @media (max-width: 1079px) {
    .index__row {
      grid-template-columns: 2.75rem minmax(0, 1fr) minmax(0, 1.4fr);
    }

    .index__line {
      grid-column: 2;
    }

    .index__items {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }

  @media (max-width: 819px) {
    .moment,
    .moment--flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .moment--flip > :first-child {
      order: 0;
    }

    .stack {
      height: 340px;
    }

    .stack__label {
      display: none;
    }

    .stack__legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--s-2) var(--s-5);
      font-size: var(--step--1);
      color: var(--ink-2);
      margin-top: calc(-1 * var(--s-6));
    }

    .stack__legend strong {
      color: var(--ink);
    }

    .stack__plane {
      width: 190px;
    }

    .stack__plane--result {
      --z: 90px;
    }

    .stack__plane--pixels {
      --z: -90px;
    }

    .index__row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--s-3) var(--s-4);
    }

    .index__line,
    .index__items {
      grid-column: 2;
      grid-row: auto;
    }
  }
</style>

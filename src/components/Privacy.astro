---
const points = [
  {
    title: 'Processed on your Mac',
    text: 'Best Quality runs the model with Core ML, Fast mode uses Apple Vision, and the fallback uses ONNX Runtime — all locally. There is no server to send anything to.',
    icon: 'M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5V15H4V6.5ZM2.5 15h19l-1 2.5a1 1 0 0 1-.93.63H4.43a1 1 0 0 1-.93-.63L2.5 15Z',
  },
  {
    title: 'No account, no tracking',
    text: 'No sign-in, no telemetry, no analytics and no ads. CutOut doesn’t know who you are and doesn’t try to find out.',
    icon: 'M12 3.5 5 6.5v5c0 4.2 2.9 7.7 7 9 4.1-1.3 7-4.8 7-9v-5l-7-3ZM9 12l2.2 2.2L15.5 10',
  },
  {
    title: 'The clipboard, only when you paste',
    text: 'CutOut reads the clipboard when you press ⌘V or choose Paste — it never watches it in the background.',
    icon: 'M9 4.5h6M9 4.5a1.5 1.5 0 0 0-1.5 1.5v.5h9V6A1.5 1.5 0 0 0 15 4.5M7.5 5.5H6A1.5 1.5 0 0 0 4.5 7v12A1.5 1.5 0 0 0 6 20.5h12a1.5 1.5 0 0 0 1.5-1.5V7A1.5 1.5 0 0 0 18 5.5h-1.5',
  },
  {
    title: 'Network only if you ask',
    text: 'The app makes no network requests unless you start a model download yourself — and the full download already includes the model.',
    icon: 'M3.5 9.5a12 12 0 0 1 17 0M6.5 12.5a7.8 7.8 0 0 1 11 0M9.5 15.5a3.6 3.6 0 0 1 5 0M12 18.5h.01M4 4l16 16',
  },
];
---

<section class="section privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap privacy__grid">
    <header class="section-head privacy__head" data-reveal>
      <p class="eyebrow">Privacy</p>
      <h2 class="h2" id="privacy-title">Your images stay on your&nbsp;Mac.</h2>
      <p class="lede">Removing a background shouldn’t mean handing your photos to someone else’s server. With CutOut it doesn’t.</p>
    </header>
    <ul class="privacy__list" role="list">
      {
        points.map((p, i) => (
          <li class="privacy__item" data-reveal={String((i % 2) + 1)}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={p.icon} />
            </svg>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .privacy {
    background: var(--paper-raised);
    border-block: 1px solid var(--rule);
  }

  .privacy__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(var(--s-6), 5vw, var(--s-9));
    align-items: start;
  }

  .privacy__head {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-7));
    margin-bottom: 0;
  }

  .privacy__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .privacy__item {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-strong);
  }

  .privacy__item svg {
    width: 28px;
    height: 28px;
    color: var(--cut);
    margin-bottom: var(--s-2);
  }

  .privacy__item h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .privacy__item .muted {
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (max-width: 1079px) {
    .privacy__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .privacy__head {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .privacy__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// The opening scene. Layers, bottom to top, all aligned to the same photo frame:
//   canvas  — WebGL: the photo as a print that peels off, revealing the transparency grid
//   poster  — the same photo as an <img> (first paint; also the no-WebGL / reduced-motion view)
//   shadow  — the cutout's soft shadow, shown as it lifts
//   word    — the giant wordmark, *behind* the subject (difference blend: dark on the photo, light on the stage)
//   subject — CutOut's real cutout
//   line    — the cut: marching ants along the outline traced from CutOut's matte
import '../assets/generated/hero/hero.css';
import meta from '../assets/generated/hero/hero.json';
import photo960 from '../assets/generated/hero/photo-960.webp?url';
import photo1400 from '../assets/generated/hero/photo-1400.webp?url';
import photo1800 from '../assets/generated/hero/photo-1800.webp?url';
import photo960a from '../assets/generated/hero/photo-960.avif?url';
import photo1400a from '../assets/generated/hero/photo-1400.avif?url';
import photo1800a from '../assets/generated/hero/photo-1800.avif?url';
import subject960 from '../assets/generated/hero/subject-960.webp?url';
import subject1400 from '../assets/generated/hero/subject-1400.webp?url';
import subject1800 from '../assets/generated/hero/subject-1800.webp?url';
import subject960a from '../assets/generated/hero/subject-960.avif?url';
import subject1400a from '../assets/generated/hero/subject-1400.avif?url';
import subject1800a from '../assets/generated/hero/subject-1800.avif?url';
import shadow from '../assets/generated/hero/shadow.webp?url';
import { isReleased, mac, formatBytes } from '../data/release';

const set = (a: string, b: string, c: string) => `${a} 960w, ${b} 1400w, ${c} 1800w`;
const sizes = '(max-width: 819px) 88vw, min(88vw, 1200px)';
const W = meta.width;
const H = meta.height;
---

<section class="hero" data-scene data-ranges="cut:.03-.3 lift:.27-.42 peel:.4-.86 end:.78-.98" data-hero aria-labelledby="hero-title">
  <div class="pin hero__pin">
    <canvas
      class="hero__gl"
      aria-hidden="true"
      data-gl
      data-subject-960-webp={subject960}
      data-subject-1400-webp={subject1400}
      data-subject-1800-webp={subject1800}
      data-subject-960-avif={subject960a}
      data-subject-1400-avif={subject1400a}
      data-subject-1800-avif={subject1800a}></canvas>
    <div class="hero__stage" data-stage>
      <picture class="hero__poster">
        <source type="image/avif" srcset={set(photo960a, photo1400a, photo1800a)} sizes={sizes} />
        <img
          srcset={set(photo960, photo1400, photo1800)}
          src={photo1400}
          sizes={sizes}
          width={W}
          height={H}
          alt={`${meta.alt}, photographed on a grey background.`}
          fetchpriority="high"
          decoding="async"
          data-poster
        />
      </picture>
      <img class="hero__shadow" src={shadow} alt="" width={W} height={H} decoding="async" />
      <p class="hero__word" aria-hidden="true">CutOut</p>
      <picture class="hero__subject">
        <source type="image/avif" srcset={set(subject960a, subject1400a, subject1800a)} sizes={sizes} />
        <img
          srcset={set(subject960, subject1400, subject1800)}
          src={subject1400}
          sizes={sizes}
          width={W}
          height={H}
          alt="The same crankset with its background removed by CutOut — the gaps between the chainring teeth are transparent too."
          decoding="async"
          data-subject
        />
      </picture>
      <svg class="hero__line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <mask id="cut-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
            <path d={meta.path} class="hero__draw" pathLength="1"></path>
          </mask>
        </defs>
        <path d={meta.path} class="hero__ants hero__ants--glow" mask="url(#cut-reveal)"></path>
        <path d={meta.path} class="hero__ants hero__ants--dash" mask="url(#cut-reveal)"></path>
      </svg>
    </div>

    <div class="hero__ui wrap">
      <h1 class="hero__title" id="hero-title"><span class="visually-hidden">CutOut: </span>Keep the subject.<br />Lose the background.</h1>
      <div class="hero__actions">
        <button class="btn btn--ghost" type="button" aria-pressed="false" data-toggle hidden>Remove background</button>
        <a class="btn" href="#get" data-magnetic data-primary-cta>
          {isReleased ? 'Download for Mac' : 'Get CutOut'}
          <span class="btn__meta">{isReleased ? `${mac.version} · ${formatBytes(mac.size)}` : 'Free · Mac'}</span>
        </a>
      </div>
    </div>
    <p class="hero__hint" aria-hidden="true"><span></span>Scroll</p>
  </div>
</section>

<style>
  .hero {
    height: 300svh;
  }

  .hero__pin {
    display: grid;
    place-items: center;
    background: var(--bg);
  }

  /* The photo frame: the photo's own aspect on wide screens, cropped to 4:5 on phones. */
  .hero__stage {
    position: relative;
    width: min(84vw, calc((100svh - 250px) * var(--ar)), 1200px);
    aspect-ratio: var(--ar);
    margin-top: -56px;
  }

  .hero__stage::before {
    /* The transparency grid the print is stuck to. */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 22px;
    background-color: var(--checker-a);
    background-image: conic-gradient(var(--checker-b) 25%, transparent 0 50%, var(--checker-b) 0 75%, transparent 0);
    background-size: 32px 32px;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  /* The canvas covers the whole viewport so the print can be pulled right off the screen. It sits
     in the same stacking context as the wordmark, whose difference blend therefore reaches it. */
  .hero__gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  :global(.hero.is-live) .hero__gl {
    opacity: 1;
  }

  :global(.hero.is-live) .hero__stage::before,
  :global(.hero.is-live) .hero__poster {
    visibility: hidden;
  }

  .hero__poster,
  .hero__poster img,
  .hero__subject,
  .hero__subject img,
  .hero__shadow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__poster img {
    border-radius: 22px;
    transition: opacity 700ms var(--ease), scale 900ms var(--ease), filter 900ms var(--ease);
  }

  /* Without WebGL the print falls away with the scroll. */
  :global(.hero.is-lite) .hero__poster img {
    transition: none;
    opacity: calc(1 - var(--peel, 0));
    scale: calc(1 + var(--peel, 0) * 0.06);
    filter: blur(calc(var(--peel, 0) * 16px));
  }

  /* Reduced motion: the "Remove background" button does it in one step. */
  :global(.hero[data-bg='off']) .hero__poster img {
    opacity: 0;
    scale: 1.03;
  }

  .hero__shadow {
    opacity: calc(var(--lift, 0) * 0.9);
    translate: calc(var(--lift, 0) * 1.2%) calc(var(--lift, 0) * 2.4%);
    pointer-events: none;
  }

  :global(.hero[data-bg='off']) .hero__shadow {
    opacity: 0.9;
    translate: 1.2% 2.4%;
    transition: opacity 700ms var(--ease), translate 700ms var(--ease);
  }

  .hero__word {
    position: absolute;
    left: 50%;
    top: var(--word-y);
    width: 100vw;
    translate: calc(-50% + var(--mx, 0) * -22px) calc(-50% + var(--my, 0) * -10px);
    font-size: min(26vw, 34svh);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.065em;
    line-height: 0.8;
    text-align: center;
    white-space: nowrap;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    user-select: none;
  }

  .hero__subject,
  .hero__line {
    translate: calc(var(--mx, 0) * var(--lift, 0) * 12px) calc(var(--lift, 0) * -1.4% + var(--my, 0) * var(--lift, 0) * 8px);
    scale: calc(1 + var(--lift, 0) * 0.03);
  }

  :global(.hero[data-bg='off']) .hero__subject {
    translate: 0 -1.4%;
    scale: 1.03;
    transition: translate 700ms var(--ease), scale 700ms var(--ease);
  }

  .hero__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: calc(1 - var(--end, 0));
  }

  .hero__draw {
    fill: none;
    stroke: #fff;
    stroke-width: 60;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--cut, 0));
  }

  .hero__ants {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .hero__ants--glow {
    stroke: var(--cut);
    stroke-width: 6;
    opacity: 0.55;
    filter: blur(3px);
  }

  .hero__ants--dash {
    stroke: #fff;
    stroke-width: 2;
    stroke-dasharray: 8 7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__ants--dash {
      animation: march 650ms linear infinite;
    }
  }

  @keyframes march {
    to {
      stroke-dashoffset: -15;
    }
  }

  .hero__ui {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(20px, 4svh, 44px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .hero__title {
    font-size: clamp(1.25rem, 0.95rem + 1vw, 1.75rem);
    font-weight: 640;
    font-stretch: 108%;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero__actions {
    display: flex;
    gap: 10px;
  }

  .hero__hint {
    position: absolute;
    left: 50%;
    bottom: 12px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 6px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
    opacity: calc(1 - min(var(--p, 0) * 14, 1));
  }

  .hero__hint span {
    width: 1px;
    height: 26px;
    background: linear-gradient(transparent, var(--fg-2));
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__hint span {
      animation: hint 1.8s var(--ease-io) infinite;
    }
  }

  @keyframes hint {
    0% {
      scale: 1 0;
      opacity: 1;
    }
    60% {
      scale: 1 1;
      opacity: 1;
    }
    100% {
      scale: 1 1;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__hint {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .hero__hint {
      display: none;
    }
  }

  @media (max-width: 819px) {
    .hero {
      height: 240svh;
    }

    /* Phones keep the part's own shape, so the whole crankset stays visible. */
    .hero__stage {
      width: min(86vw, calc((100svh - 360px) * var(--ar)));
      margin-top: -40px;
    }

    .hero__stage::before,
    .hero__poster img {
      border-radius: 18px;
    }

    /* The word sits on the frame's top edge: the part overlaps only its lower half. */
    .hero__word {
      top: -1%;
      font-size: 24vw;
    }

    .hero__ui {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      bottom: 24px;
    }

    .hero__title {
      font-size: 1.5rem;
    }

    .hero__actions {
      flex-direction: row-reverse;
    }

    .hero__actions .btn {
      flex: 1;
    }
  }
</style>

<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>

---
import { Picture } from 'astro:assets';
import Split from './Split.astro';
import removed from '../assets/screens/app-removed.png';
import tools from '../assets/screens/app-tools.png';

const widths = [800, 1200, 1600, 2360];
const sizes = '(max-width: 819px) 94vw, min(86vw, 1240px)';
---

<section class="appwin" id="app" data-scene data-ranges="rise:0-.42 swap:.55-.7 cap:.3-.5" aria-labelledby="app-title">
  <div class="pin appwin__pin">
    <header class="appwin__head wrap">
      <Split as="h2" id="app-title" class="title title--m" text="A real Mac app." />
      <p class="sub appwin__sub">Simple until you need more — the tools stay folded away until <kbd>⌥⌘T</kbd>.</p>
    </header>
    <div class="appwin__window">
      <div class="appwin__shot appwin__shot--a">
        <Picture src={removed} widths={widths} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" alt="CutOut with the golden retriever puppy cut out on a transparency grid, a “Background removed” message and “Core ML · GPU” in the status bar." loading="lazy" decoding="async" />
      </div>
      <div class="appwin__shot appwin__shot--b">
        <Picture src={tools} widths={widths} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="webp" alt="CutOut with the tools sidebar open: selection, retouch and create tools, and the Magic Eraser’s tolerance, contiguous, anti-alias and feather options." loading="lazy" decoding="async" />
      </div>
    </div>
    <p class="appwin__note dim">Genuine CutOut 0.1 windows, rendered by the app’s own self-test.</p>
  </div>
</section>

<style>
  .appwin {
    height: 260svh;
  }

  .appwin__pin {
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: center;
    justify-items: center;
    padding-block: calc(var(--nav-h) + 24px) 28px;
    perspective: 1800px;
  }

  .appwin__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 40px;
  }

  .appwin__sub {
    max-width: 30ch;
    opacity: var(--cap, 1);
  }

  .appwin__sub kbd {
    font-family: var(--font);
    font-size: 0.85em;
    padding: 2px 7px;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--fg);
  }

  .appwin__window {
    position: relative;
    width: min(86vw, calc((100svh - 300px) * 1.62), 1240px);
    aspect-ratio: 2360 / 1456;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), 0 60px 160px -40px rgb(0 0 0 / 1), 0 0 120px -20px rgb(143 132 255 / 0.18);
    transform-origin: 50% 100%;
    transform: rotateX(calc((1 - var(--rise, 1)) * 32deg)) translateY(calc((1 - var(--rise, 1)) * 10svh)) scale(calc(0.84 + var(--rise, 1) * 0.16));
    opacity: calc(0.2 + var(--rise, 1) * 0.8);
  }

  .appwin__shot,
  .appwin__shot :global(picture),
  .appwin__shot :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .appwin__shot--b {
    opacity: var(--swap, 0);
  }

  .appwin__note {
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .appwin__pin {
      grid-template-rows: auto auto auto;
      gap: 40px;
    }

    .appwin__shot--b {
      opacity: 1;
    }
  }

  @media (max-width: 819px) {
    .appwin {
      height: 220svh;
    }

    .appwin__window {
      width: 94vw;
      border-radius: 10px;
    }
  }
</style>

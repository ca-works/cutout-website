---
import Chapter from './Chapter.astro';
import Eq from './Eq.astro';
import Kind from './Kind.astro';
import Cite from './Cite.astro';
import Deep from './Deep.astro';
import data from '../../assets/generated/science/science.json';
import { groundTruth } from '../../data/science';

const files = import.meta.glob('../../assets/generated/science/edge-*', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const url = (id: string, f: string) => files[`../../assets/generated/science/edge-${id}-${f}.${f === 'rgb' ? 'webp' : 'png'}`];

const strands = groundTruth.find((g) => g.id === 'strands')!;
const disc = groundTruth.find((g) => g.id === 'disc')!;
const f3 = (v: number) => v.toFixed(3);

const samples = [
  {
    id: 'fur',
    tab: 'Fur',
    title: 'Fur: thinner than a pixel',
    credit: 'Photo: SapphireDreamPhotography, CC BY 3.0',
    text: 'A single hair is narrower than a pixel, so every pixel along the outline is part puppy, part carpet. A yes-or-no mask turns that into a staircase; the soft matte keeps the fraction. Compare “Raw” with “Matte”: the network predicted at 1024 × 1024, about one value for every 2.6 × 1.9 photo pixels here, and the guided filter re-drew the edge from the photo’s own colours.',
    metrics: '',
  },
  {
    id: 'seeds',
    tab: 'Seeds',
    title: 'Seeds: fine, pale and against the sky',
    credit: 'Photo: Adesolive, CC0',
    text: 'Dandelion filaments are fine, nearly white and seen against a pale sky, so colour barely separates subject from background. The matte keeps them as faint, partial values instead of dropping them, but the faintest tips sit right at the limit of what the photo itself records.',
    metrics: '',
  },
  {
    id: 'strands',
    tab: 'Strands',
    title: 'Strands: measured against the truth',
    credit: 'Synthetic test scene generated by CutOut’s benchmark tool',
    text: 'A drawn scene with 1–3 px strands, so the true alpha of every pixel is known exactly. That makes it possible to measure, not just look.',
    metrics: `Refined: IoU ${f3(strands.refined.iou)}, edge error ${f3(strands.refined.edge)}. Raw prediction: IoU ${f3(strands.raw.iou)}, edge error ${f3(strands.raw.edge)}.`,
  },
  {
    id: 'glass',
    tab: 'Glass',
    title: 'Glass: a limit of segmentation',
    credit: 'Photo: Paolo Neo, public domain (Wikimedia Commons)',
    text: 'BiRefNet answers “object or not”, so it outlines the glass and marks the inside as solid. The white background seen through the bowl stays in the cutout. A truly see-through cutout needs a different kind of model, one that estimates transparency and the colour behind it. CutOut does not do that today.',
    metrics: '',
  },
  {
    id: 'disc',
    tab: 'Translucent',
    title: 'A translucent disc: a measured failure',
    credit: 'Synthetic test scene generated by CutOut’s benchmark tool',
    text: 'The disc is 45 % opaque everywhere, so its true alpha is 0.45. CutOut predicts it as solid. Switch to “Error” to see where the matte disagrees with the truth.',
    metrics: `IoU ${f3(disc.refined.iou)}, mean error ${f3(disc.refined.mae)}. This is the one test scene that fails.`,
  },
];
const views = [
  { id: 'rgb', label: 'Photo' },
  { id: 'matte', label: 'Matte' },
  { id: 'cut', label: 'Cutout' },
  { id: 'on', label: 'On colour' },
  { id: 'hard', label: 'Binary' },
  { id: 'raw', label: 'Raw', needs: 'raw' },
  { id: 'gt', label: 'Truth', needs: 'gt' },
  { id: 'err', label: 'Error', needs: 'gt' },
];
---

<section class="sci-sec" aria-labelledby="edges">
  <div class="wrap">
    <Chapter
      n="04"
      id="edges"
      scale="Scale: one hair ≈ one pixel"
      title="Why hair, fur and glass are hard."
      lede="Most of a cutout is easy. Nearly all of the difficulty, and nearly all of the visible quality, lives in a band a few pixels wide along the edge."
    />

    <figure class="lab edge" data-sci="edges">
      <div class="tabs" role="tablist" aria-label="Edge sample">
        {
          samples.map((s, i) => (
            <button type="button" class="seg__btn" role="tab" id={`edge-tab-${s.id}`} aria-controls={`edge-panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-edge-tab={s.id}>
              {s.tab}
            </button>
          ))
        }
      </div>
      {
        samples.map((s, i) => {
          const e = (data.edges as Record<string, { rect: { left: number; top: number }; files: string[] }>)[s.id];
          return (
            <div class="edge__panel" role="tabpanel" id={`edge-panel-${s.id}`} aria-labelledby={`edge-tab-${s.id}`} hidden={i !== 0} data-edge-panel={s.id} data-rgb={url(s.id, 'rgb')} data-matte={url(s.id, 'matte')} data-raw={e.files.includes('raw') ? url(s.id, 'raw') : undefined} data-gt={e.files.includes('gt') ? url(s.id, 'gt') : undefined}>
              <div class="edge__view">
                <div class="edge__frame checker">
                  <canvas class="edge__canvas" width="360" height="360" role="img" aria-label={`${s.title}: magnified 360 by 360 pixel region`} data-edge-canvas />
                  <img class="lab__fallback" src={url(s.id, 'rgb')} width="360" height="360" alt={`${s.title}: magnified region of the photo`} loading="lazy" decoding="async" />
                </div>
                <p class="edge__mag tabular" aria-hidden="true">
                  360 × 360 px · from ({e.rect.left}, {e.rect.top})
                </p>
              </div>
              <div class="edge__text">
                <h3 class="edge__h">{s.title}</h3>
                <p>{s.text}</p>
                {s.metrics && <p class="edge__metrics tabular"><Kind k="app" /> {s.metrics}</p>}
                <div class="seg seg--wrap edge__views" role="radiogroup" aria-label="View" hidden data-edge-views>
                  {views
                    .filter((v) => !v.needs || e.files.includes(v.needs))
                    .map((v, j) => (
                      <button type="button" class="seg__btn" role="radio" aria-checked={j === 1 ? 'true' : 'false'} tabindex={j === 1 ? 0 : -1} data-edge-view={v.id}>
                        {v.label}
                      </button>
                    ))}
                </div>
                <p class="edge__credit dim small">{s.credit}</p>
              </div>
            </div>
          );
        })
      }
      <figcaption class="lab__cap">
        <Kind k="app" /> Real CutOut mattes (BiRefNet, Best Quality settings) at full resolution. “Raw” is the same prediction with edge refinement switched off. “Truth” and “Error” exist only for the two
        synthetic scenes, whose exact alpha is known. IoU compares the mattes rounded to yes/no; edge error is the mean alpha difference within 6 px of the true outline.<Cite ids="cutout-models" />
      </figcaption>
    </figure>

    <div class="prose-grid">
      <div class="prose">
        <h3 class="sci-h3">Why the problem has no unique answer</h3>
        <p>
          Run the compositing equation backwards. For each pixel the photo gives three numbers, its red, green and blue. The unknowns are the subject's colour, the background's colour and alpha:
          seven. Three equations cannot pin down seven unknowns, so infinitely many cutouts reproduce the same photo exactly.<Cite ids="smithblinn" /> <Kind k="concept" />
        </p>
        <Eq display n={15} tex={String.raw`\underbrace{\mathbf{I}}_{3\ \text{known}}=\underbrace{\cA{\alpha}}_{1}\,\underbrace{\cF{\mathbf{F}}}_{3}+(1-\cA{\alpha})\,\underbrace{\cB{\mathbf{B}}}_{3}`} />
        <p>
          A neural network settles the ambiguity with what it learned from labelled examples during training: what fur, wheels and cups tend to look like. Where that prior is wrong, the cutout is wrong.
          Glass is worse still. It bends and tints the light behind it, so even the equation above does not describe it.
        </p>
        <ul class="facts">
          <li><Kind k="app" /> <strong>Holes.</strong> A gap whose inside looks like a plausible surface can be kept. In CutOut's tests, the slot in a chrome bracket was kept. Magic Eraser removes it in one click.</li>
          <li><Kind k="app" /> <strong>Low contrast.</strong> A white gear with bolt holes on beige was cut out with IoU 0.9994 against its exact ground truth.</li>
          <li><Kind k="app" /> <strong>True transparency</strong> (glass, smoke, the disc above) is not solved by segmentation. Matting models are a possible future step.</li>
        </ul>
      </div>
    </div>

    <div class="deeps">
      <Deep level="technical" title="Removing the background's colour from the edge (Decontaminate)">
        <p>
          A soft edge pixel still holds some of the old background's colour. Composited over a new background it shows as a halo, such as beige in the fur over blue. Refine Edges ▸
          <em>Decontaminate</em> re-estimates the subject colour <Eq tex={String.raw`\cF{F}`} /> of every partly transparent pixel with the fast “blur-fusion” approximation.<Cite ids="forte" />
          Fully opaque and fully transparent pixels are untouched, and Restore brings back the original colours. <Kind k="app" />
        </p>
      </Deep>
      <Deep level="maths" title="Blur-fusion foreground estimation, as implemented">
        <p>With <Eq tex={String.raw`\mathcal{G}_{r}`} /> a blur of radius <Eq tex="r" /> (two box passes in CutOut), each pass estimates smooth foreground and background colours:</p>
        <Eq display n={16} tex={String.raw`\hat{\cF{F}}=\frac{\mathcal{G}_{r}(\cF{F}\,\cA{\alpha})}{\mathcal{G}_{r}(\cA{\alpha})},\qquad \hat{\cB{B}}=\frac{\mathcal{G}_{r}\big(\cB{B}(1-\cA{\alpha})\big)}{\mathcal{G}_{r}(1-\cA{\alpha})}`} />
        <p>It then shares the compositing residual between them in proportion to alpha:</p>
        <Eq display n={17} tex={String.raw`\begin{aligned}\rho&=\mathbf{I}-\cA{\alpha}\hat{\cF{F}}-(1-\cA{\alpha})\hat{\cB{B}}\\ \cF{F}&\leftarrow\hat{\cF{F}}+\cA{\alpha}\,\rho,\qquad \cB{B}\leftarrow\hat{\cB{B}}+(1-\cA{\alpha})\,\rho\end{aligned}`} />
        <p>
          <Kind k="app" /> CutOut runs two passes, first with a large radius <Eq tex={String.raw`6\max(s,4)`} />, then with a small one <Eq tex={String.raw`\max(s,2)`} />, where
          <Eq tex={String.raw`s=1.5\max(r,2)`} /> and <Eq tex="r" /> is the Refine Edges radius. Both estimates start from the photo itself.
        </p>
      </Deep>
    </div>
  </div>
</section>

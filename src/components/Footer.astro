---
import { release, sourcePublic, issuesUrl, websiteRepoUrl, releasesUrl } from '../data/release';

const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#get`, label: 'Download' },
  { href: `${base}docs/`, label: 'Guide' },
  { href: `${base}docs/#faq`, label: 'Questions' },
  { href: `${base}privacy/`, label: 'Privacy' },
  ...(sourcePublic ? [{ href: release.repo.url!, label: 'Source', external: true }] : []),
  ...(releasesUrl ? [{ href: releasesUrl, label: 'Releases', external: true }] : []),
  ...(release.repo.license ? [{ href: release.repo.license.url, label: `Licence (${release.repo.license.spdx})`, external: true }] : []),
  { href: issuesUrl, label: 'Report a problem', external: true },
  { href: websiteRepoUrl, label: 'Website source', external: true },
];
---

<footer class="footer">
  <div class="wrap">
    <nav aria-label="Footer">
      <ul class="footer__links" role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} {...('external' in l && l.external ? { rel: 'noopener' } : {})}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="footer__word" aria-hidden="true">CutOut</p>
    <div class="footer__legal">
      <p>© 2026 ca-works. Free background removal for Mac.</p>
      <p>
        Uses <a href="https://github.com/ZhengPeng7/BiRefNet" rel="noopener">BiRefNet</a> (MIT). <a href={`${base}docs/#credits`}>Image credits</a>. Mac and macOS are
        trademarks of Apple Inc.; CutOut is not affiliated with Apple.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(64px, 8vw, 120px);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--fg-2);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  @media (hover: hover) {
    .footer__links a:hover {
      color: var(--fg);
    }
  }

  .footer__word {
    margin: clamp(40px, 6vw, 80px) 0 0;
    font-size: min(24vw, 360px);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.07em;
    line-height: 0.78;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.16);
    user-select: none;
    translate: 0 6%;
  }

  .footer__legal {
    display: grid;
    gap: 6px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--fg-3);
  }

  .footer__legal a {
    color: var(--fg-2);
  }
</style>

---
import { Image } from 'astro:assets';
import icon from '../assets/generated/brand/icon.png';
import { release, sourcePublic, issuesUrl, websiteRepoUrl, releasesUrl } from '../data/release';

const base = import.meta.env.BASE_URL;
const year = 2026;
const columns = [
  {
    title: 'Product',
    links: [
      { href: `${base}#download`, label: 'Download' },
      { href: `${base}docs/`, label: 'Guide' },
      { href: `${base}docs/#shortcuts`, label: 'Keyboard shortcuts' },
      { href: `${base}#faq`, label: 'Questions' },
    ],
  },
  {
    title: 'Open source',
    links: [
      sourcePublic
        ? { href: release.repo.url!, label: 'Application source', external: true }
        : { href: `${base}#free`, label: 'Application source (not public yet)' },
      ...(releasesUrl ? [{ href: releasesUrl, label: 'Releases', external: true }] : []),
      ...(release.repo.license ? [{ href: release.repo.license.url, label: `Licence (${release.repo.license.spdx})`, external: true }] : []),
      { href: websiteRepoUrl, label: 'Website source', external: true },
    ],
  },
  {
    title: 'Support',
    links: [
      { href: issuesUrl, label: 'Report a problem', external: true },
      { href: `${base}docs/#contributing`, label: 'Contributing' },
      { href: `${base}docs/#security`, label: 'Security' },
      { href: `${base}privacy/`, label: 'Privacy' },
    ],
  },
];
---

<footer class="footer on-night">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <a href={base} class="footer__logo" aria-label="CutOut home">
        <Image src={icon} alt="" width={40} height={40} densities={[1, 2]} />
        <span>CutOut</span>
      </a>
      <p>Free background removal and image editing for Mac. Runs entirely on your Mac.</p>
    </div>
    {
      columns.map((c) => (
        <nav class="footer__col" aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul role="list">
            {c.links.map((l) => (
              <li>
                <a href={l.href} {...('external' in l && l.external ? { rel: 'noopener' } : {})}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap footer__legal">
    <p>© {year} ca-works. The CutOut name and icon are not covered by the website's MIT licence.</p>
    <p>
      Background removal uses <a href="https://github.com/ZhengPeng7/BiRefNet" rel="noopener">BiRefNet</a> (MIT) by Peng Zheng et al.
      <a href={`${base}docs/#credits`}>Image credits</a>
    </p>
    <p>Mac, macOS and Apple silicon are trademarks of Apple Inc. CutOut is not affiliated with Apple.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--s-9) var(--s-7);
    font-size: var(--step--1);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--s-7);
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--rule-night);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.25rem;
    font-weight: 680;
    letter-spacing: -0.03em;
    text-decoration: none;
    margin-bottom: var(--s-4);
  }

  .footer__logo img {
    width: 40px;
    height: 40px;
  }

  .footer__brand p {
    color: var(--on-night-2);
    max-width: 30ch;
  }

  .footer h2 {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--on-night);
    margin-bottom: var(--s-3);
  }

  .footer ul {
    display: grid;
    gap: 2px;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--on-night-2);
    text-decoration: none;
  }

  @media (hover: hover) {
    .footer__col a:hover {
      color: var(--on-night);
      text-decoration: underline;
    }
  }

  .footer__legal {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-5);
    color: var(--on-night-3);
    font-size: 0.8125rem;
  }

  .footer__legal a {
    color: var(--on-night-2);
  }

  @media (max-width: 819px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 420px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Compare from '../components/Compare.astro';
import Keys from '../components/Keys.astro';
import AppWindow from '../components/AppWindow.astro';
import Numbers from '../components/Numbers.astro';
import Tools from '../components/Tools.astro';
import Private from '../components/Private.astro';
import Get from '../components/Get.astro';
import photo960 from '../assets/generated/hero/photo-960.avif?url';
import photo1400 from '../assets/generated/hero/photo-1400.avif?url';
import photo1800 from '../assets/generated/hero/photo-1800.avif?url';

const title = 'CutOut — Background removal for Mac. Free and offline.';
const description = 'Keep the subject. Lose the background. CutOut cuts out machined parts, fur and fine detail in seconds, entirely on your Mac. Free.';
---

<Base
  title={title}
  description={description}
  preload={[
    {
      href: photo1400,
      as: 'image',
      type: 'image/avif',
      imagesrcset: `${photo960} 960w, ${photo1400} 1400w, ${photo1800} 1800w`,
      imagesizes: '(max-width: 819px) 88vw, min(88vw, 1200px)',
    },
  ]}
>
  <Hero />
  <Compare />
  <Keys />
  <AppWindow />
  <Numbers />
  <Tools />
  <Private />
  <Get />
</Base>
